rules_version = '2';

// PROPOSED Firestore security rules for StrangePin, v2 (security audit 2026-10-22,
// local branch audit/firebase-rules; based on PR #1 / pr/technical 4986199).
// Target project: strangepin-4e538, database (default).
// Status: PROPOSAL ONLY. Tested on the local emulator (project demo-strangepin):
// tests/rules.test.js, tests/rules-v2-audit.test.js, tests/compat-matrix.test.js,
// tests/e2e-emulator.js. NOT deployed. Deploying needs the owner's explicit approval.
//
// Changes from PR #1 (v1):
//  1. Points and pins are SERVER-OWNED. Clients can no longer award themselves points
//     (v1 allowed +35 every 30 s, about 100,000 points per day). Points must be granted by
//     the owner with the Admin SDK (which bypasses rules) after a submission is reviewed.
//     Client impact: fbAddPoints() is denied; PR #1 catches the error, so the submission
//     still succeeds but no "+pts" toast is shown (documented required client change).
//  2. Only Google sign-ins can write (defence in depth in case Anonymous or Email/Password
//     sign-in is ever enabled in the console, which would allow scripted bulk accounts).
//  3. Full schema validation: required keys (hasAll) as well as allowed keys (hasOnly),
//     types and sizes for every field, server timestamps for every time field.
//  4. Reactions, comments and saves only on real pins (curated "001".."999" ids or an
//     existing pins/{pinId} document), not on arbitrary invented ids.
//  5. A like marker can only be created on an existing comment and only together with
//     the +1 on that comment (no orphan markers, no increment without a marker).
//  6. publicProfiles can only be created together with (or after) the private users doc.
//
// Data model (unchanged from PR #1):
//   users/{uid}                      private profile (email lives here); owner only
//   users/{uid}/saved/{pinId}        owner only
//   publicProfiles/{uid}             public leaderboard card: displayName, photoURL, points, pins
//   pins/{pinId}                     curated/community pins: public read, no client writes
//   pins/{pinId}/reactions/{uid}     one reaction per user per pin
//   pins/{pinId}/comments/{cid}      public read; author-owned
//   pins/{pinId}/comments/{cid}/likes/{uid}   one like per user per comment
// Admin operations (moderation, points, verified/badges, pin publishing) are done with the
// Admin SDK or the console only; no client path exists for them.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function isUser(uid) { return signedIn() && request.auth.uid == uid; }
    function data() { return request.resource.data; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function isShortString(v, max) { return v is string && v.size() <= max; }
    function isHttpsOrEmpty(v) { return v is string && v.size() <= 1000 && (v == '' || v.matches('^https://[^\\s]*$')); }
    function isPin(pinId) {
      return pinId.matches('^[0-9]{3}$')
        || exists(/databases/$(database)/documents/pins/$(pinId));
    }
    function validNotifications(n) {
      return n is map
        && n.keys().hasOnly(['newComment', 'newReaction', 'weeklyDigest'])
        && n.get('newComment', true) is bool
        && n.get('newReaction', true) is bool
        && n.get('weeklyDigest', true) is bool;
    }
    function validEditableProfile(d) {
      return isShortString(d.displayName, 80)
        && isHttpsOrEmpty(d.photoURL)
        && isShortString(d.get('country', ''), 80)
        && isShortString(d.get('bio', ''), 500)
        && isHttpsOrEmpty(d.get('website', ''))
        && validNotifications(d.get('notifications', {}));
    }

    // ── Private user documents ──────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isUser(uid);

      allow create: if isUser(uid)
        && data().keys().hasAll(['uid','displayName','email','photoURL','points','pins',
             'badges','achievements','followers','following','verified','country','bio','website',
             'joinedAt','lastActive','notifications','_schemaVersion'])
        && data().keys().hasOnly(['uid','displayName','email','photoURL','points','pins',
             'badges','achievements','followers','following','verified','country','bio','website',
             'joinedAt','lastActive','notifications','_schemaVersion'])
        && data().uid == uid
        && isShortString(data().email, 254)
        && data().points == 0
        && data().pins == 0
        && data().verified == false
        && data().badges == []
        && data().achievements == []
        && data().followers == 0
        && data().following == 0
        && data().joinedAt == request.time
        && data().lastActive == request.time
        && data()._schemaVersion is int
        && validEditableProfile(data());

      // Profile and housekeeping fields only. points, pins, verified, badges, achievements,
      // followers, following, email, uid, joinedAt are server-owned after creation.
      allow update: if isUser(uid)
        && changed().hasOnly(['lastActive','displayName','photoURL','country','bio','website','notifications'])
        && (!changed().hasAny(['lastActive']) || data().lastActive == request.time)
        && validEditableProfile(data());

      allow delete: if false; // account deletion is an admin process (Admin SDK)

      match /saved/{pinId} {
        allow read, delete: if isUser(uid);
        allow create, update: if isUser(uid)
          && isPin(pinId)
          && data().keys().hasAll(['pinId','at'])
          && data().keys().hasOnly(['pinId','at'])
          && data().pinId == pinId
          && data().at == request.time;
      }
    }

    // ── Public leaderboard cards ────────────────────────────────────────────
    match /publicProfiles/{uid} {
      allow read: if true;
      allow create: if isUser(uid)
        && existsAfter(/databases/$(database)/documents/users/$(uid))
        && data().keys().hasAll(['displayName','photoURL','points','pins','updatedAt'])
        && data().keys().hasOnly(['displayName','photoURL','points','pins','updatedAt'])
        && data().points == 0
        && data().pins == 0
        && isShortString(data().displayName, 80)
        && isHttpsOrEmpty(data().photoURL)
        && data().updatedAt == request.time;
      // points and pins are server-owned (Admin SDK only).
      allow update: if isUser(uid)
        && changed().hasOnly(['displayName','photoURL','updatedAt'])
        && isShortString(data().displayName, 80)
        && isHttpsOrEmpty(data().photoURL)
        && data().updatedAt == request.time;
      allow delete: if false;
    }

    // ── Pins and community interaction ──────────────────────────────────────
    match /pins/{pinId} {
      allow read: if true;
      allow write: if false; // submissions arrive by email; publishing is admin-only

      match /reactions/{uid} {
        allow read: if true;
        allow create, update: if isUser(uid)
          && isPin(pinId)
          && data().keys().hasAll(['type','uid','at'])
          && data().keys().hasOnly(['type','uid','at'])
          && data().uid == uid
          && data().type in ['interesting','creepy','ufo','unexplained','favorite']
          && data().at == request.time;
        allow delete: if isUser(uid);
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn()
          && isPin(pinId)
          && data().keys().hasAll(['uid','displayName','photoURL','text','likes','at'])
          && data().keys().hasOnly(['uid','displayName','photoURL','text','likes','at'])
          && data().uid == request.auth.uid
          && data().text is string
          && data().text.size() > 0
          && data().text.size() <= 1000
          && isShortString(data().displayName, 80)
          && isHttpsOrEmpty(data().photoURL)
          && data().likes == 0
          && data().at == request.time;
        // Author may edit only the text; any signed-in user may add exactly one like,
        // and only together with creating their like marker in the same batch.
        allow update: if signedIn() && (
          (
            resource.data.uid == request.auth.uid
            && changed().hasOnly(['text'])
            && data().text is string
            && data().text.size() > 0
            && data().text.size() <= 1000
          ) || (
            changed().hasOnly(['likes'])
            && data().likes == resource.data.likes + 1
            && !exists(/databases/$(database)/documents/pins/$(pinId)/comments/$(commentId)/likes/$(request.auth.uid))
            && existsAfter(/databases/$(database)/documents/pins/$(pinId)/comments/$(commentId)/likes/$(request.auth.uid))
          )
        );
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;

        match /likes/{uid} {
          allow read: if true;
          allow create: if isUser(uid)
            && exists(/databases/$(database)/documents/pins/$(pinId)/comments/$(commentId))
            && getAfter(/databases/$(database)/documents/pins/$(pinId)/comments/$(commentId)).data.likes
                 == get(/databases/$(database)/documents/pins/$(pinId)/comments/$(commentId)).data.likes + 1
            && data().keys().hasAll(['at'])
            && data().keys().hasOnly(['at'])
            && data().at == request.time;
          allow update, delete: if false;
        }
      }
    }

    // Everything else is closed (admin, submissions, config, any future collection).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
