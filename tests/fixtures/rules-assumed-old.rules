rules_version = '2';
// ASSUMPTION ONLY - the real production rules of strangepin-4e538 are unknown (no console
// access). This models a common permissive setup that would let the old client work:
// public read, any signed-in user may write anything. Used by tests/compat-matrix.test.js.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
