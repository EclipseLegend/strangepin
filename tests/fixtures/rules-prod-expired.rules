rules_version = '2';
// OWNER-REPORTED (2026-10-22): text of the Firestore rules shown in the Firebase console for
// project strangepin-4e538, copied from the owner's message. NOT read from production by us.
// Expired test-mode rules: every request after 2026-07-04 is denied.
// Used only by tests/expired-rules.test.js and tests/e2e-expired-rules.js on the emulator.
// (rules_version must stay the first statement: a comment above it makes the emulator
// silently fall back to rules version 1.)
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write:
        if request.time < timestamp.date(2026, 7, 4);
    }
  }
}
